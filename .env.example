# RUSTY — the site's onboard intelligence.
#
# Voice + reasoning: Groq. Get a key at https://console.groq.com/keys
# Without this key RUSTY still answers using the built-in fallback brain.
GROQ_API_KEY=
# Optional: override the primary model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Live web data: Tavily. Get a key at https://app.tavily.com
# Without this key, current-events questions get an honest "I can't look
# that up right now" instead of a made-up answer.
TAVILY_API_KEY=
